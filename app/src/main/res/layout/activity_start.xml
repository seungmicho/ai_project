<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/startRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:id="@+id/startTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="나의 AI 비서"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="사용자를 선택하세요"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:layout_marginBottom="12dp" />

    <RadioGroup
        android:id="@+id/userRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="28dp">

        <RadioButton
            android:id="@+id/userMinjung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="민정"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:checked="true" />

        <RadioButton
            android:id="@+id/userHyodam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="효담"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <RadioButton
            android:id="@+id/userGuest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="게스트"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="화면 테마"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:layout_marginBottom="12dp" />

    <RadioGroup
        android:id="@+id/themeRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="40dp">

        <RadioButton
            android:id="@+id/darkModeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="다크 모드"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:checked="true" />

        <RadioButton
            android:id="@+id/lightModeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="화이트 모드"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </RadioGroup>

    <Button
        android:id="@+id/startButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="시작하기"
        android:textSize="18sp" />

</LinearLayout>